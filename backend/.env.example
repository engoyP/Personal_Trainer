# 复制为 .env 后填入自己的值（.env 已被 .gitignore 排除，不会入库）

# ---- LLM（DeepSeek，OpenAI 兼容协议）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.4

# ---- 数据库（默认 SQLite，换 PostgreSQL 只改 DATABASE_URL）----
# 路径用绝对路径或相对项目根的路径
DATABASE_URL=sqlite:///./data/fitness.db
CHECKPOINT_DB=./data/checkpoints.db
UPLOAD_DIR=./data/uploads

# ---- 博查搜索（关键词爬取用，open.bochaai.com 注册）----
BOCHA_API_KEY=

# ---- 本地语义服务（可选增强：不可用时自动退关键词检索）----
MODEL_SERVER_URL=http://127.0.0.1:8100
MODEL_SERVER_ENABLED=1
# 重排保留阈值（语料组成变化后需用 scripts/eval_semantics.py 重新标定）
MODEL_RERANK_KEEP=-2.5

# ---- OCR 识图服务（可选增强）----
OCR_SERVER_URL=http://127.0.0.1:8200
OCR_CUDA=0
